function limparDuplicatasPendentes() {
  const props = PropertiesService.getScriptProperties();
  const planilhaId = props.getProperty('PLANILHA_ID');
  if (!planilhaId) { Logger.log('PLANILHA_ID não encontrado — rode isso no mesmo projeto do iniciarCopia().'); return; }

  const fila = SpreadsheetApp.openById(planilhaId).getSheetByName('Fila');
  const destinosParaTrashar = new Set(PARES_PARA_LIMPAR.map(function (p) { return p.trashar; }));

  // 1) Acha as linhas da planilha cujo DestinoID (coluna B) está na lista
  const dados = fila.getDataRange().getValues();
  const linhasParaRemover = [];
  for (let i = 1; i < dados.length; i++) {
    if (destinosParaTrashar.has(dados[i][1])) {
      linhasParaRemover.push(i + 1); // linha real na planilha (1-based, +1 pelo cabeçalho)
    }
  }
  Logger.log('Linhas encontradas na planilha pra remover: ' + linhasParaRemover.length + ' de ' + destinosParaTrashar.size + ' esperadas.');

  // 2) Remove de baixo pra cima, senão os índices bagunçam a cada remoção
  linhasParaRemover.sort(function (a, b) { return b - a; });
  linhasParaRemover.forEach(function (linha) {
    fila.deleteRow(linha);
  });

  // 3) Move as pastas duplicadas pra lixeira do Drive
  let trashadas = 0;
  let erros = 0;
  destinosParaTrashar.forEach(function (id) {
    try {
      DriveApp.getFolderById(id).setTrashed(true);
      trashadas++;
    } catch (e) {
      Logger.log('⚠️ Erro ao mover ' + id + ' pra lixeira: ' + e.message);
      erros++;
    }
  });

  Logger.log('✅ Concluído. Linhas removidas da planilha: ' + linhasParaRemover.length +
             '. Pastas movidas pra lixeira: ' + trashadas + '. Erros: ' + erros + '.');
}
